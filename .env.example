# Local development runs against the Supabase stack in Docker.
#   pnpm db:start    boot it (prints these values)
#   pnpm db:reset    reapply all migrations from scratch
#   pnpm db:types    regenerate app/types/database.types.ts
#
# The local anon key below is the standard Supabase demo key. It is not a
# secret and is identical on every developer machine.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# The hosted project. These four are read by the Supabase CLI and by nothing
# in the app, which takes its connection from the two NUXT_PUBLIC_ vars above.
# They exist so migrations can be pushed without `supabase login`:
#
#   pnpm exec supabase db push --db-url \
#     "postgresql://postgres:<url-encoded SUPABASE_PASSWORD>@db.$SUPABASE_ID.supabase.co:5432/postgres"
#
# SUPABASE_URL is the bare origin. The dashboard shows it with `/rest/v1/`
# appended; supabase-js adds that itself, so a suffixed value makes every
# query 404.
SUPABASE_ID=
SUPABASE_PASSWORD=
SUPABASE_URL=https://<project-ref>.supabase.co
# `sb_publishable_…` — replaces the old anon JWT. Ships in the client bundle
# by design; row-level security is what guards the data.
SUPABASE_PUBLISHABLE_KEY=
# `sb_secret_…` — replaces service_role and bypasses RLS entirely. Never put
# this in GitHub, a NUXT_PUBLIC_ var, or anything the browser downloads.
SUPABASE_SECRET_KEY=

# Deploying: the GitHub Pages workflow reads NUXT_PUBLIC_SUPABASE_URL from an
# Actions *variable* and NUXT_PUBLIC_SUPABASE_KEY from an Actions *secret*.
# Set them to the hosted origin and the publishable key.

# YouTube Data API v3 key, for the channel importer (/api/youtube/import).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=timlacault

# Official FFBaD web services, for player lookup on /admin/players.
# Credentials are issued by the federation. Without them the lookup returns
# 503 and the roster form stays manual.
FFBAD_API_URL=https://apitest.ffbad.org/rest/
FFBAD_LOGIN=
FFBAD_PASSWORD=
