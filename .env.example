# Local development runs against the Supabase stack in Docker.
#   pnpm db:start    boot it (prints these values)
#   pnpm db:reset    reapply all migrations from scratch
#   pnpm db:types    regenerate app/types/database.types.ts
#
# The local anon key below is the standard Supabase demo key. It is not a
# secret and is identical on every developer machine.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# For a hosted project instead, use its URL and anon key from the dashboard,
# then `pnpm supabase link --project-ref <ref>`, `pnpm db:push`,
# `pnpm db:types:linked`.

# YouTube Data API v3 key, for the channel importer (/api/youtube/import).
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_HANDLE=timlacault

# Official FFBaD web services, for player lookup on /admin/players.
# Credentials are issued by the federation. Without them the lookup returns
# 503 and the roster form stays manual.
FFBAD_API_URL=https://apitest.ffbad.org/rest/
FFBAD_LOGIN=
FFBAD_PASSWORD=
